# Copy this file to backend/.env and fill in your values.
# Never commit backend/.env or share it.

# ---- Required ----

# Postgres connection string. In Supabase: Connect > Session pooler.
# Replace [YOUR-PASSWORD], including the brackets, with your database password.
# Use only letters and numbers in the password. Symbols like @ # / ? break this line.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# Long random text used to sign login tokens. Changing it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Optional ----

# OpenWeather API key for the weather chip in the top bar.
# Leave empty to show a placeholder of 28°C, clear sky.
OPENWEATHER_API_KEY=

# data.gov.in API key for live mandi prices.
# Leave empty to use the demo prices in the database.
OGD_API_KEY=

# Port the backend listens on.
# If you change it, the frontend also needs VITE_API_BASE_URL set to the new address.
PORT=5000

# Address of the frontend, the only website allowed to call this API.
CORS_ORIGIN=http://localhost:5173
